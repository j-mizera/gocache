{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-skill-creator"
  ],
  "instructions": [
    "AGENTS.md",
    ".opencode/rules/*.md"
  ],
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "task": "ask",
    "jetbrains_*": "ask",
    "intellij_*": "ask",
    "mcp__jetbrains__*": "ask",
    "mcp__intellij__*": "ask",
    "jetbrains_find_files_by_glob": "allow",
    "jetbrains_find_files_by_name_keyword": "allow",
    "jetbrains_generate_inspection_kts_api": "allow",
    "jetbrains_generate_inspection_kts_examples": "allow",
    "jetbrains_generate_psi_tree": "allow",
    "jetbrains_get_all_open_file_paths": "allow",
    "jetbrains_get_database_object_description": "allow",
    "jetbrains_get_file_problems": "allow",
    "jetbrains_get_file_text_by_path": "allow",
    "jetbrains_get_project_dependencies": "allow",
    "jetbrains_get_project_modules": "allow",
    "jetbrains_get_repositories": "allow",
    "jetbrains_get_run_configurations": "allow",
    "jetbrains_get_symbol_info": "allow",
    "jetbrains_list_database_connections": "allow",
    "jetbrains_list_database_schemas": "allow",
    "jetbrains_list_directory_tree": "allow",
    "jetbrains_list_recent_sql_queries": "allow",
    "jetbrains_list_schema_object_kinds": "allow",
    "jetbrains_list_schema_objects": "allow",
    "jetbrains_preview_table_data": "allow",
    "jetbrains_read_file": "allow",
    "jetbrains_search_file": "allow",
    "jetbrains_search_in_files_by_regex": "allow",
    "jetbrains_search_in_files_by_text": "allow",
    "jetbrains_search_regex": "allow",
    "jetbrains_search_symbol": "allow",
    "jetbrains_search_text": "allow",
    "jetbrains_test_database_connection": "allow",
    "mcp__jetbrains__find_files_by_glob": "allow",
    "mcp__jetbrains__find_files_by_name_keyword": "allow",
    "mcp__jetbrains__generate_inspection_kts_api": "allow",
    "mcp__jetbrains__generate_inspection_kts_examples": "allow",
    "mcp__jetbrains__generate_psi_tree": "allow",
    "mcp__jetbrains__get_all_open_file_paths": "allow",
    "mcp__jetbrains__get_database_object_description": "allow",
    "mcp__jetbrains__get_file_problems": "allow",
    "mcp__jetbrains__get_file_text_by_path": "allow",
    "mcp__jetbrains__get_project_dependencies": "allow",
    "mcp__jetbrains__get_project_modules": "allow",
    "mcp__jetbrains__get_repositories": "allow",
    "mcp__jetbrains__get_run_configurations": "allow",
    "mcp__jetbrains__get_symbol_info": "allow",
    "mcp__jetbrains__list_database_connections": "allow",
    "mcp__jetbrains__list_database_schemas": "allow",
    "mcp__jetbrains__list_directory_tree": "allow",
    "mcp__jetbrains__list_recent_sql_queries": "allow",
    "mcp__jetbrains__list_schema_object_kinds": "allow",
    "mcp__jetbrains__list_schema_objects": "allow",
    "mcp__jetbrains__preview_table_data": "allow",
    "mcp__jetbrains__read_file": "allow",
    "mcp__jetbrains__search_file": "allow",
    "mcp__jetbrains__search_in_files_by_regex": "allow",
    "mcp__jetbrains__search_in_files_by_text": "allow",
    "mcp__jetbrains__search_regex": "allow",
    "mcp__jetbrains__search_symbol": "allow",
    "mcp__jetbrains__search_text": "allow",
    "mcp__jetbrains__test_database_connection": "allow"
  },
  "command": {
    "gocache-plan": {
      "description": "Create a GoCache implementation plan for",
      "template": "Create a GoCache implementation plan for: $ARGUMENTS\n\nUse OpenCode-native project sources only:\n\n- `AGENTS.md`\n- `.opencode/rules/gocache-decision-discipline.md`\n- `.opencode/rules/gocache-architecture.md`\n- `.opencode/rules/gocache-verification.md`\n- `.opencode/rules/gocache-documentation.md`\n- `.opencode/IMPLEMENTATION_STATUS.md`\n- relevant `docs/adr/`, `docs/plugins/`, `docs/gcpc/`, `docs/server/`, `docs/performance/` files\n- Obsidian notes under `projects/gocache/` for recent context, treated as fast local memory and verified against repo files before use\n- Redis docs/source for command and RESP semantics\n- Go docs and Context7 for current Go/library/API behavior\n- battle-tested OSS systems only as implementation inspiration, never as authority over Redis semantics or GoCache ADRs\n\nPlan format:\n\n1. Goal and non-goals.\n2. Existing evidence and file paths.\n3. Decision points requiring user confirmation.\n4. ADR/design-doc requirement judgment.\n5. Implementation steps.\n6. Test/verification commands.\n7. Documentation/status updates.\n\nIf any uncertainty, technical decision, doubt, unknown, or plausible alternative remains, ask before implementation.\n"
    },
    "gocache-status": {
      "description": "Summarize the current GoCache implementation status for this repo.",
      "template": "Summarize the current GoCache implementation status for this repo.\n\nRead these sources first:\n\n- `.opencode/IMPLEMENTATION_STATUS.md`\n- `README.md`\n- `docs/adr/README.md`\n- `docs/plugins/README.md`\n- `docs/gcpc/README.md`\n- `docs/server/README.md`\n- `docs/performance/README.md`\n- `Taskfile.yml`\n\nReturn:\n\n1. Current completed phases/features.\n2. Active or proposed ADRs that matter now.\n3. Known gaps or stale/conflicting claims.\n4. Verification commands relevant to the user's requested next step.\n\nUse repository docs and code as evidence, with `.opencode/IMPLEMENTATION_STATUS.md` as the OpenCode status snapshot.\n"
    },
    "gocache-verify": {
      "description": "Run or plan GoCache verification for the current change.",
      "template": "Run or plan GoCache verification for the current change.\n\nUse `.opencode/rules/gocache-verification.md` as the checklist. Choose the smallest meaningful verification scope, then widen when the change touches multiple packages, plugins, APIs, or performance-sensitive paths.\n\nDefault full ritual:\n\n```bash\ngo build ./...\ngo test -race ./...\ngo vet ./...\nstaticcheck ./...\nscripts/check-plugin-isolation.sh\n```\n\nBefore running expensive benchmarks or choosing a benchmark scope, ask the user.\n\nReport exact commands, pass/fail result, and any skipped check with reason.\n"
    },
    "thesis-ai-report": {
      "description": "Update and review AI-use reporting for thesis work",
      "template": "Update and review AI-use reporting for thesis work: $ARGUMENTS\n\nUse `thesis-gocache-vistula`.\n\nWorkflow:\n\n1. Read `.opencode/thesis/reports/ai-usage-log.md` if present.\n2. Scan recent generated thesis materials for AI-assisted draft markings, unlogged AI text, and de-AI rewrite status.\n3. Update the log with tool, date, purpose, affected file/section, prompt summary, output summary, citations/evidence checked, and human rewrite status.\n4. Do not automatically label diagrams; log diagram-related AI assistance internally and flag final compliance review.\n5. Produce `.opencode/thesis/reports/ai-compliance-review.md` when requested.\n"
    },
    "thesis-edit": {
      "description": "Edit Polish thesis text for",
      "template": "Edit Polish thesis text for: $ARGUMENTS\n\nUse `thesis-gocache-vistula`.\n\nRules:\n\n1. Preserve technical meaning and citations.\n2. Use formal academic Polish.\n3. Explain edits in Polish.\n4. Flag unsupported claims instead of inventing sources.\n5. If generating AI-assisted draft text, italicize working draft text and update `reports/ai-usage-log.md`.\n6. Prefer de-AI rewriting: remove AI filler, make prose precise, and keep author-rewrite status visible.\n"
    },
    "thesis-export": {
      "description": "Export thesis Markdown to DOCX for",
      "template": "Export thesis Markdown to DOCX for: $ARGUMENTS\n\nUse `thesis-gocache-vistula`.\n\nWorkflow:\n\n1. Confirm target Markdown file(s) under `.opencode/thesis/markdown/`.\n2. Prefer DOCX export first: `python .opencode/skills/thesis-gocache-vistula/scripts/thesis_tools.py export-docx [markdown-file]`.\n3. Use Vistula/reference DOCX styling when available.\n4. Write output to `.opencode/thesis/exports/`.\n5. Report exact command, output path, warnings, and remaining manual formatting checks.\n6. Do not produce final submission files without explicit user approval.\n"
    },
    "thesis-gap-analysis": {
      "description": "Gap-analyze the Vistula thesis/Konspekt against current GoCache evidence for",
      "template": "Gap-analyze the Vistula thesis/Konspekt against current GoCache evidence for: $ARGUMENTS\n\nUse `thesis-gocache-vistula`.\n\nWorkflow:\n\n1. Read `.opencode/thesis/source/Konspekt.odt` or its converted Markdown if present.\n2. Inspect GoCache docs, ADRs, tests, Taskfile, benchmarks, diagrams, and README evidence.\n3. Generate/update `.opencode/thesis/generated/konspekt-gap-analysis.md`.\n4. Classify each item as obsolete assumption, missing section, unsupported claim, missing citation, missing repo evidence, Vistula compliance gap, or supervisor question.\n5. Include concrete file paths and suggested fixes.\n"
    },
    "thesis-generate-bibliography": {
      "description": "Generate or update thesis bibliography for",
      "template": "Generate or update thesis bibliography for: $ARGUMENTS\n\nUse `thesis-gocache-vistula`.\n\nWorkflow:\n\n1. Read existing citations and source notes from `.opencode/thesis/markdown/`, `generated/`, and `bibliography/`.\n2. Create or update `.opencode/thesis/bibliography/references.bib` and `.opencode/thesis/bibliography/source-notes.md`.\n3. Include only sources actually used or consulted.\n4. Flag missing bibliographic metadata instead of inventing it.\n5. Prefer authoritative sources and mark source quality.\n"
    },
    "thesis-generate-chapter": {
      "description": "Generate or revise thesis chapter material for",
      "template": "Generate or revise thesis chapter material for: $ARGUMENTS\n\nUse `thesis-gocache-vistula`.\n\nWorkflow:\n\n1. Identify target chapter/section and required source evidence.\n2. Read repository artifacts and Vistula requirements before drafting.\n3. Produce formal Polish academic draft material in `.opencode/thesis/markdown/` or `.opencode/thesis/generated/` as appropriate.\n4. Italicize AI-assisted draft text intended to remain visible in the working draft.\n5. Update `reports/ai-usage-log.md` and mark human rewrite status.\n6. Add TODO markers for missing citations, missing evidence, and supervisor questions.\n"
    },
    "thesis-import": {
      "description": "Import thesis source documents into Markdown for",
      "template": "Import thesis source documents into Markdown for: $ARGUMENTS\n\nUse `thesis-gocache-vistula`.\n\nWorkflow:\n\n1. Read `.opencode/thesis/README.md` and inspect `.opencode/thesis/source/`.\n2. Run dependency check with `python .opencode/skills/thesis-gocache-vistula/scripts/thesis_tools.py check`.\n3. Convert requested DOCX/ODT/PDF files into `.opencode/thesis/markdown/` using `python .opencode/skills/thesis-gocache-vistula/scripts/thesis_tools.py import [paths...]`.\n4. Preserve Polish text, headings, tables, footnotes, references, and captions when possible.\n5. Do not overwrite existing Markdown working files by default; only use `--force` when the user explicitly wants regeneration.\n6. Record limitations, conversion status, and generated markdown links in `.opencode/thesis/README.md`.\n7. Do not overwrite source files.\n"
    },
    "thesis-index": {
      "description": "Update the master thesis index for",
      "template": "Update the master thesis index for: $ARGUMENTS\n\nUse `thesis-gocache-vistula`.\n\nWorkflow:\n\n1. Scan `.opencode/thesis/source/`, `markdown/`, `translated/`, `generated/`, `diagrams/`, `reports/`, `bibliography/`, and `exports/`.\n2. Update `.opencode/thesis/README.md` with source documents, descriptions, conversion status, chapter ownership, review status, bibliography status, export status, unresolved issues, TODO items, and links to generated Markdown.\n3. Do not invent descriptions; mark unknown descriptions as TODO.\n"
    },
    "thesis-review": {
      "description": "Review thesis material for",
      "template": "Review thesis material for: $ARGUMENTS\n\nUse `thesis-gocache-vistula`.\n\nReview for:\n\n1. Vistula compliance.\n2. Formal academic Polish.\n3. Unsupported claims.\n4. Citation and plagiarism risk.\n5. Repository traceability.\n6. AI-assisted draft markings and `reports/ai-usage-log.md` consistency.\n7. De-AI rewrite needs.\n\nReturn findings with file paths, severity, evidence, and recommended fixes. Do not rewrite unless asked.\n"
    },
    "thesis-sync-adrs": {
      "description": "Sync GoCache ADRs into thesis architecture notes for",
      "template": "Sync GoCache ADRs into thesis architecture notes for: $ARGUMENTS\n\nUse `thesis-gocache-vistula`.\n\nWorkflow:\n\n1. Read `docs/adr/` and related architecture docs.\n2. Summarize accepted decisions, context, alternatives, consequences, and thesis relevance.\n3. Update `.opencode/thesis/generated/adr-traceability.md`.\n4. Identify diagrams or sections that should reference each ADR.\n"
    },
    "thesis-sync-diagrams": {
      "description": "Sync or prepare thesis diagrams for",
      "template": "Sync or prepare thesis diagrams for: $ARGUMENTS\n\nUse `thesis-gocache-vistula` and the PlantUML workflow.\n\nWorkflow:\n\n1. Inspect existing PlantUML sources under `docs/server/design/`, `docs/gcpc/design/`, plugin design folders, `.opencode/thesis/diagrams/`, and generated/pipeline assets.\n2. Prefer `.puml` sources plus pipeline-generated exports for thesis figures; do not redraw diagrams manually when a repository PlantUML source and generated asset already exist.\n3. Update `.opencode/thesis/generated/diagram-inventory.md` with diagram purpose, source `.puml` path, pipeline/generated export path, thesis section, and manual compliance notes.\n4. Do not automatically place AI labels on diagrams. If AI contributed to diagram drafting, log it internally and flag final labeling for user/supervisor review.\n5. Treat Draw.io/Inkscape as legacy/import fallback only. Missing `drawio` or `inkscape` must not block the normal PlantUML/pipeline diagram workflow; record legacy-only exports as manual/not applicable when those tools are absent.\n"
    },
    "thesis-sync-repo": {
      "description": "Sync GoCache repository evidence into thesis notes for",
      "template": "Sync GoCache repository evidence into thesis notes for: $ARGUMENTS\n\nUse `thesis-gocache-vistula`.\n\nWorkflow:\n\n1. Scan relevant repository artifacts: README files, docs, ADRs, source modules, tests, Taskfile, benchmark outputs, diagrams.\n2. Update `.opencode/thesis/generated/repository-artifacts.md` with a traceability map.\n3. Separate verified implementation facts from planned/aspirational material.\n4. Add citation/evidence anchors for claims that can be used in thesis chapters.\n"
    }
  }
}

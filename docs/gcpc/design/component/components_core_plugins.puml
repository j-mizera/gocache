@startuml components_core_plugins
!include ../../../design/theme.iuml

frame "GoCache - Core + Plugin System Architecture" as F {

    actor "Client" as client <<Redis CLI / App>>
    cloud "Prometheus" as prom
    cloud "Jaeger / OTLP backend" as jaeger

    rectangle "GoCache Server" as server {

        component [RESP Protocol] as resp <<Parser>>

        rectangle "Core Engine" as core {
            component [In-Memory\nCache] as cache <<Storage>>
            component [Command\nDispatcher] as cmd <<Engine>>
            component [Background\nWorkers] as workers <<TTL / Snapshots>>
            component [Command Metrics\nAggregate] as metrics <<query snapshot>>
            component [Log Collector] as logs <<runtime.logs batches>>
        }

        rectangle "Plugin System" as plugin_sys {
            component [IPC Transport] as ipc <<Unix Socket / Protobuf>>
            component [Permission\nLayer] as perm <<Scopes + Hooks>>
            component [Lifecycle Mgr] as lifecycle <<Registry + Health>>
            component [Event Bus] as eventbus <<operation.* + runtime.logs>>
        }

        rectangle "Embedded Plugins" as embedded {
            component [lifecycleotlp] as lifecycleotlp <<pre-IPC traces>>
            component [crashdump] as crashdump <<panic files>>
        }
    }

    rectangle "IPC Plugin: instrumentation" as instr_proc {
        component [Plugin SDK] as instr_sdk
        component [OTLP Trace Exporter] as traces
        component [OTLP Log Exporter] as otlplogs
    }

    rectangle "IPC Plugin: prometheus" as prom_proc {
        component [Plugin SDK] as prom_sdk
        component [/metrics HTTP] as http
    }

    client --> resp : RESP commands
    resp --> cmd : Dispatch
    cmd --> cache : Read/Write
    cmd --> metrics : cheap aggregate when queried
    cmd --> eventbus : operation.started/completed
    logs --> eventbus : runtime.logs batch

    eventbus --> ipc : EventV1 delivery
    ipc --> instr_sdk : GCPC events
    instr_sdk --> traces : spans
    instr_sdk --> otlplogs : log records
    traces --> jaeger : OTLP HTTP
    otlplogs --> jaeger : OTLP HTTP

    http --> prom : Prometheus scrape
    prom_sdk --> ipc : ServerQueryV1\nmetrics.commands
    ipc --> metrics : snapshot response

    lifecycleotlp --> jaeger : startup/config/shutdown OTLP
    crashdump --> logs : crash diagnostics
}

note bottom
  Observability split:
  - Prometheus metrics are query/pull only.
  - Runtime instrumentation consumes event/log batches.
  - lifecycleotlp remains embedded for pre-IPC lifecycle visibility.
end note

@enduml

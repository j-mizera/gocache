@startuml sequence_plugin_commands
!include ../../../design/theme.iuml

mainframe **sd** Command Flow with Plugin Hooks & Context

actor Client
participant "Pipeline" as Pipeline
participant "Hook Executor" as HookExec
participant "Hook Registry" as HookReg
participant "PluginConn\n(multiplexed)" as PluginConn
participant "Auth Plugin\n(critical, priority=1)" as AuthPlugin
participant "Cache" as Cache
participant "Event Bus" as EventBus
participant "Instrumentation Plugin\n(EventPlugin)" as InstrPlugin

Client -> Pipeline : SET user:1 {name: John}

== Initialize Context ==

Pipeline -> Pipeline : hookCtx = command.NewHookCtx()\nhookCtx["_start_ns"] = now()\nhookCtx["_operation_id"] = op.ID
Pipeline -> EventBus : operation.started(op)
EventBus ->> InstrPlugin : EventV1 operation.started

== Pre-Hooks ==

Pipeline -> HookExec : RunPreHooks("SET", args, hookCtx)
HookExec -> HookReg : MatchPre("SET")
HookReg --> HookExec : [Auth(crit, pri=1)]\nsorted by priority
HookExec -> HookExec : metadata = extractRexMetadata(hookCtx)\n{traceparent: "...", tenant: "..."}
HookExec -> PluginConn : Send HookRequestV1 (PRE)\ncontext: {_start_ns, _operation_id, shared.rex.*}\nmetadata: {traceparent, tenant}
PluginConn -> AuthPlugin : HookRequestV1\n(request_id=req-1)
activate AuthPlugin
AuthPlugin --> PluginConn : HookResponseV1\n(deny=false, context_values: {tenant_id: "acme"})
deactivate AuthPlugin
PluginConn --> HookExec : Allow
HookExec -> HookExec : command.MergeHookCtx(hookCtx, "auth", values)
HookExec --> Pipeline : PreHookResult{Denied=false, Context=hookCtx}

== Command Execution ==

Pipeline -> Cache : Engine.DispatchWithResult(fn)
activate Cache
Cache --> Pipeline : Result{Value: "OK"}
deactivate Cache
Pipeline -> Pipeline : hookCtx["_elapsed_ns"] = elapsed()

== Optional Post-Hooks ==

Pipeline -> HookExec : RunPostHooks(...)\nonly for reaction plugins that requested hooks
note right of HookExec
  Metrics are not command hooks.
  Prometheus reads aggregate metrics through
  server:query:metrics.commands.
end note

== Async Observability ==

Pipeline -> EventBus : operation.completed(op)
EventBus ->> InstrPlugin : EventV1 operation.completed
Pipeline --> Client : +OK

@enduml

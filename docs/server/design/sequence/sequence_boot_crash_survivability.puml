@startuml sequence_boot_crash_survivability
!include ../../../design/theme.iuml

title Boot + crash survivability (embedded plugins + bootstate + crashdump)

participant "main()" as M
participant "zerolog (stderr)" as L
participant "embedded.Registry" as ER
participant "bootstate" as BS
participant "config.Load" as C
participant "crashdump" as CD
participant "lifecycleotlp\n(embedded)" as LOTLP
participant "runtime" as R

M -> L : InitStderr - JSON from line 1
M -> BS : Write(stage=embedded_boot)
M -> M : defer { recover -> crashdump.WriteFromPanic }
note right of M
  Registered FIRST - survives every later defer,
  including embedded.ShutdownAll.
end note

M -> M : embBootOp = ops.New(TypeStartup)\nenrich("_boot_stage", "embedded_boot")
M -> ER : BootAll(ctx + embBootOp)
activate ER
ER -> LOTLP : BootInit(child op)
ER -> ER : invoke all registered embedded plugins\nStrict panic -> Fatal\nDefault panic -> log + continue
ER --> M
deactivate ER
M -> M : embBootOp.Complete()
M -> M : defer { embShutOp = ops.New(TypeShutdown)\n  embedded.ShutdownAll(ctx + embShutOp)\n  embShutOp.Complete() }

M -> BS : Write(stage=config_load)
M -> C : Load(flags)
alt Config parse OK
  C --> M : cfg
  M -> M : cfgOp = ops.New(TypeConfigReload)\nenrich("_boot_stage", "config_loaded")
  M -> ER : ConfigLoadedAll(ctx + cfgOp, cfg)
  ER -> LOTLP : ConfigLoaded(child op)\nupgrade endpoint from env/YAML
  note right of LOTLP
    lifecycleotlp covers startup/config/shutdown
    before IPC plugins can connect.
    Runtime instrumentation is IPC-only.
  end note
  M -> M : cfgOp.Complete()
else Panic during Load
  C ->> M : panic
  M -> M : deferred recover
  M -> BS : Read(previous stage)
  M -> CD : WriteFromPanic(stage=config_load, ...)
  note right of CD
    If mkdir/write fails, JSON
    goes to stderr as fallback.
  end note
  M -> R : re-panic -> stack trace + exit 2
end

M -> BS : Write(stage=core_init)
M -> M : cache / engine / watch / tracker init
M -> BS : Write(stage=plugin_load)
M -> M : pluginManager.Start(ctx)\nIPC plugins may now connect
M -> BS : Write(stage=snapshot_load)
M -> BS : Write(stage=workers_start)
M -> BS : Write(stage=listener_start)
M -> BS : Write(stage=running)

== On next boot (previous run crashed) ==
M -> BS : Read
BS --> M : stage != running
M -> L : Warn "previous_run_stage=plugin_load crashed=true"

@enduml

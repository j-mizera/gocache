@startuml sequence_command_flow
!include ../../../design/theme.iuml

mainframe **sd** Core Command Flow (Hot Path, per-shard locking)

actor Client
    participant "TCP Listener\n(net.Listener)" as Listener
    participant "Connection Handler\n(per-goroutine)" as ConnHandler
    participant "RESP Reader\n(resp.NewReader)" as Reader
    participant "Pipeline\n(Pipeline)" as Pipeline
    participant "Hook Executor" as HookExec
    participant "Command Router\n(plugin fallback)" as CmdRouter
    participant "Engine\n(direct shard mutex)" as Engine
    participant "Cache Router\n(shardIndexOf)" as Router
    participant "Shard(s)\n(write lock held)" as Shards
    participant "RESP Writer\n(resp.NewWriter)" as Writer

    Client -> Listener : TCP connect
    Listener -> ConnHandler : Accept -> go handleConnection(conn)

    hnote over ConnHandler
      Creates resp.Reader, resp.Writer,
      and ClientContext (ProtoVersion=2)
    end note

    loop Per command (until EOF or QUIT)
        ConnHandler -> ConnHandler : Check isShuttingDown

        ConnHandler -> Reader : reader.Read()
        Reader -> Reader : Parse RESP Array\nfrom wire bytes

        alt Not an Array or empty
            ConnHandler -> Writer : MarshalError("protocol error")
            Writer --> Client : -ERR Protocol error

        else QUIT command
            ConnHandler -> Writer : OK()
            Writer --> Client : +OK
            hnote over ConnHandler : return (conn.Close + wg.Done)

        else Auth required and not authenticated
            ConnHandler -> Writer : MarshalError("NOAUTH")
            Writer --> Client : -NOAUTH Authentication required.

        else Valid command
            ConnHandler -> Pipeline : Evaluate(ctx, op, args)

            hnote over Pipeline
              Lookup handler in map.
              Validate arg count via commandSpecs.
              Classify by sharding behavior:
              KeyArgIndex (single-key) or
              MultiKey (touched-shard set).
            end note

            alt Unknown command (not in core handlers)
                Pipeline -> CmdRouter : HasCommand(op)?
                alt Plugin command found
                    Pipeline -> Pipeline : metadata = rex.BuildMetadata(...)
                    CmdRouter -> CmdRouter : Route via IPC\n(CommandRequestV1 + metadata)
                    CmdRouter --> Pipeline : Result from plugin
                else Not found
                    Pipeline --> ConnHandler : Result{ErrUnknown}
                end

            else In transaction (not MULTI/EXEC/DISCARD)
                Pipeline --> ConnHandler : Queue command -> Result{"QUEUED"}

            else Normal core command
                Pipeline -> HookExec : RunPreHooks(op, args)
                alt Pre-hook denies
                    HookExec --> Pipeline : Denied{reason}
                    Pipeline --> ConnHandler : Result{"-DENIED reason"}
                else Pre-hook allows (or no hooks)
                    HookExec --> Pipeline : OK

                    alt Single-key handler (most common)
                        Pipeline -> Engine : DispatchToShard(ctx, shardIdx, fn)
                        Engine -> Router : acquire shard lock
                        Router -> Shards : shard.Lock()
                        activate Shards
                        Router -> Shards : fn() reads/mutates shard state
                        Shards --> Router : result
                        Router -> Shards : shard.Unlock()
                        deactivate Shards
                        Router --> Engine : result
                    else Multi-key handler (MGET / MSET / SINTER ...)
                        Pipeline -> Pipeline : touched := cache.TouchedShards(keys)
                        Pipeline -> Engine : DispatchToShards(ctx, touched, fn)
                        Engine -> Router : acquire touched shards in sorted order
                        Router -> Shards : Lock all in touched set
                        activate Shards
                        Router -> Shards : fn() runs across the locked subset
                        Shards --> Router : result
                        Router -> Shards : Unlock in reverse
                        deactivate Shards
                        Router --> Engine : result
                    else Full-bulk handler (KEYS / FLUSHDB / SAVE)
                        Pipeline -> Engine : DispatchWithResult(ctx, fn)
                        Engine -> Router : acquire ALL shards
                        Router -> Shards : Lock(0..N-1)
                        activate Shards
                        Router -> Shards : fn() across the whole keyspace
                        Shards --> Router : result
                        Router -> Shards : Unlock all
                        deactivate Shards
                        Router --> Engine : result
                    end

                    Engine --> Pipeline : result

                    Pipeline -> HookExec : RunPostHooks(op, args, result)
                    note right : Non-critical: async\nCritical: blocks

                    Pipeline --> ConnHandler : Result{Value}
                end
            end

            ConnHandler -> ConnHandler : mapToResp(ctx, result)
            ConnHandler -> Writer : Write(resp.Value)
            Writer --> Client : RESP-encoded response
        end
    end

note right of Engine
  **Direct shard mutex**: each dispatch method
  acquires shard lock(s) directly on the calling
  goroutine. No channels, no per-shard goroutines.
  Cross-shard handlers (MSET, SINTER, MGET) pay
  a structural cache-line bounce per shard touched.
  Audit at docs/audits/per-shard-arc-summary.md
  measures the residual MSET regression.
end note

@enduml

@startuml sequence_transaction
!include ../../../design/theme.iuml

mainframe **sd** MULTI/EXEC/DISCARD Transaction Flow

actor Client
    participant "Pipeline" as Pipeline
    participant "Transaction\nManager" as TxMgr
    participant "ClientContext" as ClientCtx
    participant "Engine" as Engine
    participant "Cache" as Cache

    == MULTI: Begin Transaction ==

    Client -> Pipeline : MULTI
    Pipeline -> TxMgr : Multi(ctx)

    alt Already in transaction
        TxMgr --> Pipeline : ErrNestedMulti
        Pipeline --> Client : -ERR MULTI calls can not be nested

    else Not in transaction
        TxMgr -> ClientCtx : StartTransaction()
        hnote over ClientCtx
          InTransaction = true
          CommandQueue = []
        end note
        TxMgr --> Pipeline : "OK"
        Pipeline --> Client : +OK
    end

    == Queuing Phase ==

    loop Each command while InTransaction
        Client -> Pipeline : SET key value (or any command)
        Pipeline -> Pipeline : Check: ctx.InTransaction\n&& op != MULTI/EXEC/DISCARD

        alt Command is QUIT
            Pipeline --> Client : +OK (close connection)

        else Any other command
            Pipeline -> ClientCtx : EnqueueCommand([op, args...])
            hnote over ClientCtx : CommandQueue = append(queue, parts)
            Pipeline --> Client : +QUEUED
        end
    end

    == EXEC: Atomic Execution ==

    Client -> Pipeline : EXEC

    alt Not in transaction
        Pipeline --> Client : -ERR EXEC without MULTI

    else In transaction
        Pipeline -> ClientCtx : InTransaction = false
        Pipeline -> ClientCtx : Drain CommandQueue

        Pipeline -> Engine : DispatchWithResult(batchFn)

        hnote over Engine
          Acquires all shard locks,
          holds them for entire batch
        end note

        Engine -> Cache : cache.Lock()
        activate Cache

        loop For each queued command
            Engine -> Pipeline : evaluateInternal(op, args, inBatch=true)
            Pipeline -> Cache : Execute handler (e.g. SET, GET)
            Cache --> Pipeline : individual result
        end

        Engine -> Cache : cache.Unlock()
        deactivate Cache

        Engine --> Pipeline : []results
        Pipeline --> Client : *N (RESP Array of results)
    end

    == DISCARD: Abort Transaction ==

    Client -> Pipeline : DISCARD

    alt Not in transaction
        Pipeline -> TxMgr : Discard(ctx)
        TxMgr --> Pipeline : ErrDiscardWithoutMulti
        Pipeline --> Client : -ERR DISCARD without MULTI

    else In transaction
        Pipeline -> TxMgr : Discard(ctx)
        TxMgr -> ClientCtx : ResetTransaction()
        hnote over ClientCtx
          InTransaction = false
          CommandQueue = nil
        end note
        TxMgr --> Pipeline : "OK"
        Pipeline --> Client : +OK
    end

@enduml

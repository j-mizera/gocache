@startuml components_event_bus_ring
!include ../../../design/theme.iuml

frame "Event Bus with Replay Ring" as F {

    package "pkg/events" as EV {
        component "Bus" as BUS
        database "Replay ring\n(bounded FIFO)" as RING
        component "Subscribers map\n(type -> handlers)" as SUBS
    }

    rectangle "Emitters" as EMIT {
        component "Operation tracker\noperation.started/completed" as OPS
        component "pkg/logcollector\nperiodic runtime.logs batches" as LC_SRC
        component "Connection / plugin\nlifecycle facts" as LIFE
        component "Replay overflow\nreplay.gap" as GAP
    }

    rectangle "Subscribers" as SUB {
        component "IPC instrumentation plugin\nOTLP traces + logs" as INSTR
        component "Other IPC event plugins\n(custom diagnostics)" as IPC
        component "Embedded plugins\n(crashdump, lifecycle listeners)" as EMB
    }

    OPS --> BUS : Emit operation.started\noperation.completed
    LC_SRC --> BUS : Emit RuntimeLogBatchEventV1\n(type runtime.logs)
    LIFE --> BUS : Emit low-volume facts
    GAP --> BUS : Emit replay.gap marker

    BUS --> RING : retain replayable classes
    BUS --> SUBS : dispatch live by type

    BUS -> INSTR : Subscribe snapshot + live\noperation.*, runtime.logs, replay.gap
    BUS -> IPC : Subscribe snapshot + live
    BUS -> EMB : Subscribe if registered in-process
}

note bottom of RING
  Capacity: events.replay_capacity.
  Overflow drops oldest and emits replay.gap.
  Runtime logs are retained as batches, not
  one event per raw log line.
end note

note top of BUS
  Subscribe captures the ring snapshot under
  the same write lock that gates Emit, then
  delivers replay before live events.
end note

note right of LC_SRC
  Current runtime OTLP slice keeps the existing
  stdout/JSON/plain-text log collector.
  Unix-socket/yamux log transport is deferred.
end note

@enduml

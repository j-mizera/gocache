@startuml sequence_metrics_collection
!include ../../../../design/theme.iuml

mainframe **sd** Prometheus Metrics Collection

actor Client
participant "GoCache Server" as Server
participant "Command Metrics\nCollector" as ServerCollector
participant "Prometheus\nPlugin" as Plugin
participant "Local Collector" as Collector
actor "Prometheus" as Prom

== Command Execution ==

Client -> Server : SET user:1 "John"
Server -> Server : Execute command\nMeasure elapsed time

== In-process Metrics Aggregation ==

Server -> ServerCollector : RecordCommand("SET", 150000, false)
activate ServerCollector
ServerCollector -> ServerCollector : total["SET"]++\nsum_ns["SET"] += 150000\nbucket[0]++
deactivate ServerCollector

Server --> Client : +OK
note left : Response does not wait\nfor Prometheus plugin IPC.

== Prometheus Scrape ==

Prom -> Plugin : GET /metrics
Plugin -> Server : QueryServer("metrics.commands")
activate Server
Server -> ServerCollector : Snapshot()
ServerCollector --> Server : aggregate rows
Server --> Plugin : ServerQueryResponseV1\ncounts + buckets + errors
Plugin -> Collector : ReplaceFromQuery(snapshot)
Plugin -> Collector : WritePrometheus(w)
activate Collector
Collector -> Collector : Lock, snapshot, unlock
Collector --> Plugin : Prometheus text format
deactivate Collector
deactivate Server
Plugin --> Prom : text/plain\ngocache_commands_total{command="SET"} 1\ngocache_command_duration_seconds_bucket{...}

@enduml
